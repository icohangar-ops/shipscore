# ShipScore environment
# SQLite database location. Local dev: a file in the workspace is fine.
# On read-only/ephemeral hosts (Vercel), ShipScore automatically falls back
# to <tmpdir>/shipscore/db/custom.db — you can leave this unset there.
DATABASE_URL=file:./db/custom.db

# Fix-agent real-PR gate (all three required to actually open a PR):
# FIX_AGENT_ENABLED=1
# GITHUB_TOKEN=ghp_xxx
