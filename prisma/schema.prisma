// ShipScore — Prisma schema (Day 3-4: score persistence)
//
// SQLite for the hackathon build; the same schema lifts to Postgres by
// swapping the datasource provider. Every scan that runs through the web
// app lands in ScanRecord, so the live scoreboard survives restarts,
// redeployments and the venue wifi dying mid-demo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One row per completed scan. Summary columns power the scoreboard
/// queries; reportJson keeps the full ScanReport (incl. touchpoints)
/// so the fix agent can plan PRs from a persisted record without re-scanning.
model ScanRecord {
  id            String   @id @default(cuid())
  /// canonical repo identity: "self" or "github.com/<owner>/<repo>"
  repoKey       String
  /// display label, e.g. "openai/openai-node" or "shipscore (self-scan)"
  repo          String
  /// full GitHub URL when the scan came from a URL, null otherwise
  repoUrl       String?
  owner         String?
  name          String?
  overallScore  Int
  /// A | B | C | D | F
  grade         String
  scoreDesign   Int
  scoreShip     Int
  scoreRun      Int
  scoreSecure   Int
  scoreTest     Int
  engineVersion String
  filesScanned  Int
  filesWithTouchpoints Int
  totalLines    Int
  totalTouchpoints Int
  criticalCount Int
  highCount     Int
  durationMs    Int
  /// score notes (why the score moves), JSON array of strings
  notesJson     String
  /// full scan payload (ScanReport + clone meta), JSON
  reportJson    String
  /// web | api | action | cli — where the scan was triggered from
  source        String   @default("web")
  createdAt     DateTime @default(now())

  @@index([repoKey, createdAt])
  @@index([createdAt])
}
